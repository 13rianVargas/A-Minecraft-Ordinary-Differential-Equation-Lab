# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Raw experiment logs — contain player IP addresses, usernames and UUIDs.
# Never commit these. See CONTRIBUTING.md for how the pipeline is exercised
# without them.
logs/
*.log
*.log.gz

# ...except the synthetic fixtures the parser tests run against. These are
# hand-written and contain no player data.
!tests/fixtures/*.log

# Local backups of raw lab data. Same rule as logs/ — these hold player IP
# addresses, usernames and UUIDs and must never be committed.
backups/

# Local configuration
.env

# Editors / OS
.DS_Store
.idea/
.vscode/
~$*.docx

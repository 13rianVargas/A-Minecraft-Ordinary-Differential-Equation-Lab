# Configuration for scripts/extract.sh.
# Copy to .env and fill in for your own lab host. .env is gitignored.

# How the server log is reached on the host.
#   direct — REMOTE_LOG is readable by SSH_USER over plain SSH
#   docker — the server runs in a container; the log is read via `docker exec`
ACCESS_MODE=direct

# Host running the Minecraft server. An SSH config alias works here too, in
# which case SSH_USER and SSH_KEY can be left empty.
SSH_HOST=lab-host.example.com

# SSH account. Leave empty to use the current user or the SSH config default.
SSH_USER=

# Private key to authenticate with. Leave empty to use the SSH agent or the
# SSH config default. Never commit a key, and never put one in this repo.
SSH_KEY=

# Container name. Only used when ACCESS_MODE=docker.
MC_CONTAINER=

# Path to the live server log.
#   ACCESS_MODE=direct — path on the host
#   ACCESS_MODE=docker — path inside the container
# Always the live log, never a rotated .gz archive: those hold earlier runs.
REMOTE_LOG=/data/logs/latest.log
